DG_LISTEN_ADDR=:8787
# 业务后端启动种子：仅在 OSS、紧急 OSS 和完整缓存全部不可用时接管
DG_BUSINESS_BASE_URL=
# 多业务后端启动种子（逗号分隔），优先于单地址种子
# DG_BUSINESS_BASE_URLS=https://api-primary.example.com,https://api-backup.example.com
DG_BUSINESS_FAILURE_THRESHOLD=2
DG_BUSINESS_CIRCUIT_SECONDS=90
DG_BUSINESS_HEALTH_INTERVAL_SECONDS=30
DG_BUSINESS_RECOVERY_SUCCESSES=3
DG_BUSINESS_BACKUP_MIN_HOLD_SECONDS=180
DG_PUBLIC_BASE_URL=http://127.0.0.1:8787
DG_API_PREFIX=/api/v1
DG_DATA_FILE=./data/device-gateway.json
DG_ADMIN_TOKEN=你的管理Token
DG_TOKEN_SECRET=你的TOKEN密钥
DG_SESSION_TTL_HOURS=720
# 会话失效后再保留30天；独立于设备清理，不删除仍有效的会话
DG_SESSION_RETENTION_DAYS=30
DG_DEVICE_POLICY=kick_oldest
DG_DEFAULT_DEVICE_LIMIT=1
DG_HTTP_TIMEOUT_SECONDS=20
# 入站HTTP限制（与上面的业务后端请求超时不同）
DG_SERVER_HEADER_TIMEOUT_SECONDS=5
DG_SERVER_READ_TIMEOUT_SECONDS=30
DG_SERVER_WRITE_TIMEOUT_SECONDS=90
DG_SERVER_IDLE_TIMEOUT_SECONDS=60
# 单实例每IP每分钟令牌桶；多实例总限额应再由可信反向代理统一控制
DG_LOGIN_RATE_PER_MINUTE=60
DG_PUBLIC_AUTH_RATE_PER_MINUTE=30
DG_QR_CREATE_RATE_PER_MINUTE=60
DG_QR_POLL_RATE_PER_MINUTE=2400
DG_ADMIN_RATE_PER_MINUTE=600
DG_RATE_LIMIT_MAX_KEYS=4096
# QR活动/待清除会话总数，PG模式跨实例共享限额；所有实例保持相同值
DG_QR_MAX_ACTIVE_SESSIONS=10000
# 仅在网关只能由可信反向代理访问且代理覆盖转发头时设true
DG_TRUST_FORWARDED_FOR=false
DG_IP_REGION_DB=./data/ip2region.db
# OSS 远程配置源（与客户端 config.yaml 的 remote_config.sources 一致）
DG_OSS_CONFIG_URLS=https://162.14.118.116:17541/down/EJEOtevuiZJH.json,https://162.14.118.116:17541/down/nKpvOaTLD2BF.json,https://162.14.118.116:17541/down/LWswZpykXDpx.json
# 普通 OSS 全部失败后才访问；留空则使用程序内置紧急 OSS
# DG_EMERGENCY_OSS_CONFIG_URL=https://emergency.example.com/cat.json
# XOR 解密密钥（与客户端 XOR_KEY dart-define 一致，替换为你的实际密钥）
DG_OSS_XOR_KEY=CHANGE_ME_TO_YOUR_SECRET_KEY_32C
# 后台启用“签名加密 v2”时填写客户端配置中心显示的 Ed25519 公钥
# DG_OSS_SIGNING_PUBLIC_KEY=BASE64_PUBLIC_KEY
# 当前与上一份原始签名/加密OSS封装；读取重新校验。旧明文解析缓存不再信任
# 每实例独立缓存文件；不要放临时目录或让多个进程共用文件
DG_OSS_CACHE_FILE=./data/device-gateway-remote-config.json
# 新鲜72小时，之后只允许额外168小时离线宽限；设0可关闭额外宽限
DG_OSS_CACHE_TTL_HOURS=72
DG_OSS_OFFLINE_GRACE_HOURS=168
# 单个 OSS 请求超时（秒），普通源会并发请求
DG_OSS_FETCH_TIMEOUT=15
# OSS 远程配置自动刷新间隔（分钟），0 禁用
DG_OSS_REFRESH_MINUTES=30

# === PostgreSQL 共享存储（可选，多实例部署时启用）===
# 配置后启动时从 PostgreSQL 加载数据，持久化也写入 PostgreSQL
# 不配置则继续使用本地 JSON 文件（DG_DATA_FILE）
# DG_POSTGRES_DSN=postgres://device_gateway:password@127.0.0.1:5432/device_gateway?sslmode=disable

# 从 PostgreSQL 同步数据到内存的间隔（秒），默认 30
# 查询在锁外执行，不会阻塞客户端请求
# DG_DB_SYNC_SECONDS=30
